{
  "permissions": {
    "ask": ["Edit", "Write"]
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 ~/.config/nvim/scripts/show_agent_sidebar.py claude walkthrough", "timeout": 5}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 ~/.config/nvim/scripts/show_agent_sidebar.py claude walkthrough", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 ~/.config/nvim/scripts/show_agent_sidebar.py claude walkthrough", "timeout": 5}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "python3 ~/.config/nvim/scripts/show_agent_sidebar.py claude walkthrough", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 ~/.config/nvim/scripts/show_agent_sidebar.py claude walkthrough", "timeout": 5}]}
    ],
    "PermissionRequest": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/nvim/scripts/show_agent_sidebar.py claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/nvim/scripts/show_agent_sidebar.py claude restore",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
